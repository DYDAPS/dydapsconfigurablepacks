# Dev-only files excluded from release archives.
/tests/ export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/phpstan.neon export-ignore
/.php-cs-fixer.dist.php export-ignore
/composer.lock export-ignore

# Force LF line endings so release archives comply with the PrestaShop validator.
*.php text eol=lf
*.tpl text eol=lf
*.twig text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.dist text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.neon text eol=lf
*.xlf text eol=lf
*.txt text eol=lf
.htaccess text eol=lf
