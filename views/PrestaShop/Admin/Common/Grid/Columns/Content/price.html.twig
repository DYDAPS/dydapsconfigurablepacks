{% set value = record[column.options.field] %}
{% set decimals = column.options.decimals %}
{% if value is not empty and value is not null %}
  {{ (value + 0)|number_format(decimals, ',', ' ') }}
{% else %}
  {{ column.options.empty_value }}
{% endif %}
