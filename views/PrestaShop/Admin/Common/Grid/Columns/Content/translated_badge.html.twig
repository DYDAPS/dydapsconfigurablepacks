{% if record[column.options.field] is not empty %}
  {% set value = record[column.options.field] %}
  {% set label = column.options.labels[value]|default(value) %}
  {% set badgeType = column.options.badge_types[value]|default(column.options.default_badge_type) %}
  <span class="badge rounded badge-{{ badgeType }}">{{ label }}</span>
{% else %}
  {{ column.options.empty_value }}
{% endif %}
