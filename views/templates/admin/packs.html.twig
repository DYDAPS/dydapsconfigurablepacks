{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {% include '@Modules/dydapsconfigurablepacks/views/templates/admin/_tabs.html.twig' with {'active': active} %}

  <div class="row">
    <div class="col">
      <div class="card">
        <h3 class="card-header">
          {{ 'Configurable Packs'|trans({}, 'Modules.Dydapsconfigurablepacks.Admin') }}
        </h3>
        <div class="card-body">
          {{ 'Create pack definitions from native products, then configure components and allowed combinations.'|trans({}, 'Modules.Dydapsconfigurablepacks.Admin') }}
        </div>
      </div>
      {% include '@PrestaShop/Admin/Common/Grid/grid_panel.html.twig' with {'grid': grid} %}

      <div class="card mt-3">
        <h3 class="card-header">
          {{ 'Settings'|trans({}, 'Modules.Dydapsconfigurablepacks.Admin') }}
        </h3>
        <div class="card-body">
          <form method="post" action="{{ path('dydaps_configurable_packs_settings') }}">
            <input type="hidden" name="_csrf_token" value="{{ settingsCsrfToken }}">
            <div class="form-group">
              <label class="form-control-label">
                <input type="checkbox" name="delete_data_on_uninstall" value="1" {{ deleteDataOnUninstall ? 'checked' : '' }}>
                {{ 'Delete module data during uninstall'|trans({}, 'Modules.Dydapsconfigurablepacks.Admin') }}
              </label>
              <p class="form-text text-muted">
                {{ 'When enabled, uninstalling the module permanently removes pack definitions, cart rows, order snapshots, stock logs and refund records.'|trans({}, 'Modules.Dydapsconfigurablepacks.Admin') }}
              </p>
            </div>
            <button class="btn btn-primary" type="submit">
              {{ 'Save settings'|trans({}, 'Modules.Dydapsconfigurablepacks.Admin') }}
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('../modules/dydapsconfigurablepacks/views/js/admin-grid.js') }}"></script>
{% endblock %}
