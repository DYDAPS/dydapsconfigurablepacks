{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Modules.Dydapsconfigurablepacks.Admin' %}

{% block content %}
  {% set canRead = permissions.read %}
  {% set canCreate = permissions.create %}
  {% set canUpdate = permissions.update %}
  {% set canDelete = permissions.delete %}

  <div class="container">
    {% include '@Modules/dydapsconfigurablepacks/views/templates/admin/_tabs.html.twig' with { active: 'packs', permissions: permissions } %}

    {% if not canRead %}
      <div class="alert alert-danger">
        {{ 'You do not have permission to view this page.'|trans }}
      </div>
    {% else %}
      {% if not canUpdate %}
        <div class="alert alert-warning">
          {{ 'You can view this page but you do not have permission to update packs.'|trans }}
        </div>
      {% endif %}

      <div
        id="dydaps-pack-grid-config"
        data-can-create="{{ canCreate ? '1' : '0' }}"
        data-can-update="{{ canUpdate ? '1' : '0' }}"
        data-can-delete="{{ canDelete ? '1' : '0' }}"
        data-active-label="{{ 'Active'|trans|e('html_attr') }}"
        data-inactive-label="{{ 'Inactive'|trans|e('html_attr') }}"
      ></div>

      <div class="d-flex justify-content-end mb-3">
        {% if canCreate %}
          <a href="{{ path('dydaps_configurable_packs_create') }}" class="btn btn-primary">{{ 'Add pack'|trans }}</a>
        {% endif %}
      </div>

      <div class="row">
        <div class="col">
          {% include '@PrestaShop/Admin/Common/Grid/grid_panel.html.twig' with { grid: grid } %}
        </div>
      </div>
    {% endif %}
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('../modules/dydapsconfigurablepacks/views/js/admin-grid.js') }}"></script>
{% endblock %}
