{
    "name": "dydaps/configurable-packs",
    "version": "1.4.1",
    "description": "Configurable product packs for PrestaShop",
    "type": "prestashop-module",
    "license": "OSL-3.0",
    "autoload": {
        "psr-4": {
            "Dydaps\\ConfigurablePacks\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "prestashop/php-dev-tools": "^5.0",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "prepend-autoloader": false
    },
    "scripts": {
        "test": "phpunit tests/Unit",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
